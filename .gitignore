# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# logs
*.log
logs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (never commit secrets; .env.example is the documented template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local QA output
/qa/

# Lighthouse HTML reports are large; scores are kept in docs/seo-reports/*/summary.json
docs/seo-reports/**/*.html
docs/seo-reports/**/*.report.json

# QA screenshots and scratch output (final report screenshots live in docs/screenshots)
/qa/
/.next-e2e/
/public/images/opt/

# local ClinicFlow stack for e2e (copied from D:\ClinicFlow HEAD; never committed)
/.local-stack/

# python
__pycache__/

# Local demo logins (never committed, never pasted in chat)
/credentials/
# Staging run artefacts that hold ids (regenerated by scripts/staging/*)
/qa/staging/*.sql
/.next-prod/

# PUBLIC repo: never commit raw photos that show patients' faces (only the eye-blurred versions in public/images/photos,
# made by scripts/build-photos.mjs, are published) or the posters with a stock model (no rights to her face).
/images/patient-treatment.jpeg
/images/treatment-chair-equipment-patient*.jpeg
/images/dent-plus-banner*.jpeg
/images/interior-main-entrance.jpeg
# Owner's planning prompt (internal, not part of the site)
/DentPlus_Claude_Code_Prompt.md
