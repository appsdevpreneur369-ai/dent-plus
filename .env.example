# DPC (Dent Plus) website — build-time settings (all NEXT_PUBLIC_*; no secrets belong here). Copy to .env.local for dev,
# .env.production.local for a local production build, or pass as Docker --build-arg.
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3300
NEXT_PUBLIC_SHOW_PLACEHOLDER_BADGES=true
NEXT_PUBLIC_NOINDEX=true
# ClinicFlow247 booking API + this clinic's slug (empty = content/booking.json → no live booking)
NEXT_PUBLIC_CLINICFLOW_API_URL=
NEXT_PUBLIC_CLINICFLOW_CLINIC_SLUG=
NEXT_PUBLIC_CLINICFLOW_CLINIC_ID=
# Local/staging only: dry-run OTP shown on the booking form. Never set for production.
NEXT_PUBLIC_BOOKING_OTP_HINT=
# ClinicFlow portal base for sign-in/register links + redirects (empty = content/portal.json)
NEXT_PUBLIC_PORTAL_BASE_URL=
